VITE_STRIPE_PRICE_TEST=

# --- Edge Function secrets (set with `supabase secrets set`, never commit) ---
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GMAIL_USER=
GMAIL_APP_PASSWORD=
SITE_URL=http://localhost:5173
ADMIN_EMAIL=
