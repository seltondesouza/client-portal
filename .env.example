# --- Frontend (Vite, public) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_ADMIN_EMAIL=
# Stripe Price IDs (created in Stripe Dashboard, see README)
VITE_STRIPE_PRICE_STATIC_MONTH=
VITE_STRIPE_PRICE_STATIC_YEAR=
VITE_STRIPE_PRICE_ECOM_MONTH=
VITE_STRIPE_PRICE_ECOM_YEAR=
